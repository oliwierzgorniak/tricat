<section class="partners-carousel">
  <ul class="partners-carousel__list">
    {
      partnersImgs.map((img) => (
        <li class="partners-carousel__li">
          <Image
            class="partners-carousel__img"
            src={img}
            alt={img.src.split("/").pop().split(".")[0]}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .partners-carousel {
    overflow: hidden;
    max-width: var(--max-width);
    margin: 0 auto;
    padding-top: 4em;
    padding-bottom: 4em;
  }

  .partners-carousel__list {
    width: max-content;
    max-width: var(--max-width);
    padding: 0;
    display: flex;
    gap: 4em;
    animation: scroll 15s alternate linear infinite;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-97%);
    }
  }

  .partners-carousel__li {
    list-style-type: none;
    filter: grayscale(1);
    opacity: 0.4;
  }

  .partners-carousel__img {
    width: max-content;
    max-width: unset;
    height: 3.6rem;
  }
</style>
