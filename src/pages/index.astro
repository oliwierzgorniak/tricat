---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import IntroCarousel from "../components/IntroCarousel.astro";
import OfferGallery from "../components/OfferGallery.astro";
import PartnersCarousel from "../components/PartnersCarousel.astro";
---

<Layout>
  <Header activeSection="home" />
  <IntroCarousel />
  <section class="about">
    <h2>O nas</h2>
    <p>
      Multiagencja Ubezpieczeniowa TRICAT zajmuje się obsługą ubezpieczeniową
      klientów indywidualnych oraz firm i instytucji. Siedziba agencji znajduje
      się w Krakowie-Sidzinie przy ul. Prażmowskiego 12, ale działamy na terenie
      Małopolski, dojeżdżając indywidualnie do klientów. Współpracujemy z
      największymi towarzystwami ubezpieczeniowymi, takimi jak: WARTA, PZU,
      HESTIA, INTERRISK, HDI, COMPENSA, GENERALI, GOTHAER, AVIVA, PROAMA,
      LIBERTY UBEZPIECZENIA, UNIQA, TUZ, ALLIANZ i inne.
    </p>
    <a href="/o-nas">Zobacz więcej →</a>
  </section>
  <OfferGallery />
  <PartnersCarousel />
  <footer class="footer">
    <ul class="footer__list">
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/komunikacja">Komunikacja</a
        >
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/majatek">Majątek</a>
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/firmy">Firmy</a>
      </li>
    </ul>
    <ul class="footer__list">
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/ubezpieczenia-grupowe"
          >Ubezpieczenia grupowe</a
        >
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/turystyka">Turystyka</a>
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/ubezpieczenia-na-zycie"
          >Ubezpieczenia na życie</a
        >
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/ubezpieczenia-zdrowotne"
          >Ubezpieczenia zdrowotne</a
        >
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/oferta-tricat/przedszkola-szkoly"
          >Przedszkola / szkoły</a
        >
      </li>
    </ul>
    <ul class="footer__list">
      <li class="footer__item">
        <a class="footer__link" href="/o-nas">O nas</a>
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/do-pobrania">Do pobrania</a>
      </li>
      <li class="footer__item">
        <a class="footer__link" href="/kontakt">Kontakt</a>
      </li>
    </ul>
    <ul class="footer__list">
      <li class="footer__item">
        <a class="footer__link" href="mailto:biuro@tricat.pl">biuro@tricat.pl</a
        >
      </li>
      <li class="footer__item">
        <a
          class="footer__link"
          target="_blank"
          href="https://wynajemosuszacza.com">wynajemosuszacza.com</a
        >
      </li>
    </ul>
  </footer>
</Layout>

<style>
  .about {
    text-align: center;
    max-width: 40rem;
    margin: 1em auto;
  }

  .about p {
    line-height: 1.6;
  }

  .about a {
    font-size: 0.9;
    margin-top: 3em;
    display: inline-block;
    margin-top: 1.5em;
    color: white;
    background-color: var(--color-active);
    padding: 0.4em 0.8em;
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: filter 0.3s ease-in-out;
  }

  .about a:hover {
    filter: brightness(0.9);
  }

  .footer {
    background-color: #dedede;
    display: flex;
    justify-content: center;
    gap: 3em;
    padding: 3em;
  }

  .footer__item {
    list-style-type: "- ";
    color: #666666;
  }

  .footer__link {
    color: inherit;
    font-size: 0.8rem;
    color: #666666;
  }
</style>
