---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import IntroCarousel from "../components/IntroCarousel.astro";
import OfferGallery from "../components/OfferGallery.astro";
import PartnersCarousel from "../components/PartnersCarousel.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header activeSection="home" />
  <IntroCarousel />
  <section class="about">
    <h2>O nas</h2>
    <p>
      Multiagencja Ubezpieczeniowa TRICAT zajmuje się obsługą ubezpieczeniową
      klientów indywidualnych oraz firm i instytucji. Siedziba agencji znajduje
      się w Krakowie-Sidzinie przy ul. Prażmowskiego 12, ale działamy na terenie
      Małopolski, dojeżdżając indywidualnie do klientów. Współpracujemy z
      największymi towarzystwami ubezpieczeniowymi, takimi jak: WARTA, PZU,
      HESTIA, INTERRISK, HDI, COMPENSA, GENERALI, GOTHAER, AVIVA, PROAMA,
      LIBERTY UBEZPIECZENIA, UNIQA, TUZ, ALLIANZ i inne.
    </p>
  </section>
  <OfferGallery />
  <PartnersCarousel />
  <Footer />
</Layout>

<style>
  .about {
    text-align: center;
    max-width: 40rem;
    margin: 1em auto;
  }

  .about p {
    line-height: 1.6;
  }

  .about a {
    font-size: 0.9;
    margin-top: 3em;
    display: inline-block;
    margin-top: 1.5em;
    color: white;
    background-color: var(--color-active);
    padding: 0.4em 0.8em;
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: filter 0.3s ease-in-out;
  }

  .about a:hover {
    filter: brightness(0.9);
  }
</style>
