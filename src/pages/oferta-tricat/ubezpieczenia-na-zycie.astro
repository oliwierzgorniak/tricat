---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OfferSection from "../../components/OfferSection.astro";

import UbezpieczeniaNaZycieJpg from "../../assets/images/ubezpieczenia-na-zycie.jpg";
---

<Layout title="Na życie">
  <Header activeSection="offer" />
  <OfferSection img={UbezpieczeniaNaZycieJpg} imgAlt="Rodzina w ogrodzie">
    <div class="offer-section__text-container">
      <h2>Ubezpieczenia na życie</h2>
      <ul>
        <li>Indywidualne ubezpieczenia na życie</li>
        <li>Ubezpieczenia finansowe (zabezpieczenia kredytu)</li>
        <li>Ubezpieczenia emerytalne</li>
        <li>Grupowe ubezpieczenia na życie i inne</li>
      </ul>
    </div>
  </OfferSection>
  <Footer />
</Layout>
