---
import { Image } from "astro:assets";
import FirmyJpg from "../assets/images/firmy.jpg";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kontakt">
  <Header activeSection="home" />
  <main>
    <article class="contact">
      <h2 class="contact__title">Kontakt</h2>
      <div class="contact__image-container">
        <Image class="contact__image" src={FirmyJpg} alt={"Firma"} />
        <a class="contact__button" href="mailto:biuro@tricat.pl"
          >Wyślij wiadomość&nbsp;&nbsp;✉️</a
        >
      </div>
      <div class="contact__text-container">
        <div>
          <h3>Multiagencja Ubezpieczeniowa <strong>TRICAT</strong></h3>
          <p>Patrycja Zgórniak</p>
          <p><strong>NIP:</strong> 676 170 24 28</p>
        </div>
        <div>
          <h3>Adres</h3>
          <p>ul. Adama Prażmowskiego 12, 30-399 Kraków</p>
          <p>Kraków-Sidzina</p>
          <p>Biuro 1 piętro w budynku "Lewiatana"</p>
        </div>
        <div>
          <h3>Telefon kontaktowy</h3>
          <p>+48 603 98 98 21</p>
          <p>+48 726 620 225</p>
        </div>
        <div>
          <h3>E-mail</h3>
          <a href="mailto:biuro@tricat.pl">biuro@tricat.pl</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto max-content max-content;
    margin: 3em auto 4.5em auto;
    max-width: var(--max-width);
    width: max-content;
    gap: 2em;
    flex: 1;
  }

  .contact__image-container {
    grid-column: 1/2;
    grid-row: 2/3;
  }

  .contact__title {
    margin-bottom: 0.6em;
    text-align: center;
    grid-column: 1/3;
  }

  .contact__image {
    max-width: 30rem;
    height: min-content;
    grid-row: 2/3;
  }

  .contact__button {
    align-self: flex-start;
    display: block;
    color: white;
    background-color: var(--color-active);
    padding: 1.15em 0.7em;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: filter 0.3s ease-in-out;
    height: min-content;
    width: 100%;
    text-align: center;
    grid-row: 3/4;
    justify-self: center;
    margin-top: 1.8em;
  }

  .contact__text-container {
    display: flex;
    flex-direction: column;
    grid-row: 2/4;
    gap: 1.1em;
  }

  .contact__text-container p {
    line-height: 1.5;
    margin-bottom: 0.3em;
    max-width: 32rem;
  }
  .contact__text-container h3 {
    margin-bottom: 0.3em;
  }

  .contact__text-container a {
    color: inherit;
  }

  .contact__button:hover {
    filter: brightness(0.9);
  }
</style>
